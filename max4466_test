#include <Adafruit_GFX.h>
#include <Adafruit_ST7735.h>
#include <SPI.h>
#include <arduinoFFT.h>

#define TFT_CS   10
#define TFT_DC    9
#define TFT_RST   8
Adafruit_ST7735 tft = Adafruit_ST7735(TFT_CS, TFT_DC, TFT_RST);

const int samples = 128; // must be a power of 2 for the FFT algorithm
const int samplingFrequency = 1024; // sample rate in Hz (reads A0 1024 times per second)

double vReal[samples];
double vImag[samples];
int8_t centered[samples]; // DC-removed samples of the first accepted frame, kept for fine analysis

ArduinoFFT<double> FFT = ArduinoFFT<double>(vReal, vImag, samples, samplingFrequency);

const int noiseThreshold = 30;
const float minFreq = 70.0; // lowest note the tuner will show
const float maxFreq = 400.0;
const double peakDominanceRatio = 2.5;
const double subharmonicEnergyRatio = 0.35; // original octave check
const int silenceHoldFrames = 8;
const int inTuneCents = 10;

const int framesToSkip = 1; // discard frames right after pluck while pitch settles
const int framesToAverage = 7; // frames combined together for the locked reading

// the fine analysis may only move the FFT estimate by this much (Hz)
const double maxRefineShift = 4.0;

// a note stays on screen for at most this long, then the screen resets
const unsigned long displayHoldMs = 1000;

// after a timed reset, the tuner only listens again once the mic goes quiet
const int pluckMinSwing = 60;
const float pluckJumpRatio = 1.5;

// multiply the final frequency by this to correct a consistent clock error
const double frequencyCorrection = 1.0;

// note names stored in flash memory to save RAM
const char noteTable[12][3] PROGMEM = {"C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"};

float freqReadings[framesToAverage];

bool noteActive = false;
bool locked = false;
bool waitingForRearm = false;
bool haveStored = false; // true once centered[] holds the first accepted frame
double storedPeak = 0; // FFT peak frequency of that frame (before any octave halving)
bool storedHalved = false; // whether that frame was judged to be a 2nd harmonic
int sampleCount = 0;
int framesSeenThisNote = 0;
int silentFrameCount = 0;
int prevSwing = 0;
unsigned long lockTime = 0;

float lastFrequency = -1;
unsigned long samplingPeriodUs;
float actualSampleRate; // true sample rate after rounding the period to whole microseconds

void drawScreen() {
  tft.fillScreen(ST77XX_BLACK);
  tft.setTextColor(ST77XX_WHITE);
  tft.setTextSize(2);
  tft.setCursor(10, 10);
  tft.println(F("Guitar"));
  tft.setCursor(10, 35);
  tft.println(F("Tuner"));
  tft.setTextSize(1);
  tft.setCursor(10, 70);
  tft.println(F("Play a string"));
}

// converts a frequency into the nearest note name, octave, and cents offset
void frequencyToNote(double frequency, char* noteName, int* octave, int* cents) {
  double midiNote = 12.0 * (log(frequency / 440.0) / log(2)) + 69.0;
  int roundedNote = round(midiNote);
  double noteFrequency = 440.0 * pow(2.0, (roundedNote - 69) / 12.0);

  *cents = round(1200.0 * (log(frequency / noteFrequency) / log(2))); // 100 cents = 1 semitone

  int noteIndex = ((roundedNote % 12) + 12) % 12; // handle negative MIDI numbers 
  strcpy_P(noteName, noteTable[noteIndex]);
  *octave = (roundedNote / 12) - 1;
}

void updateDisplay(double frequency) {
  char noteName[3];
  int octave, cents;
  frequencyToNote(frequency, noteName, &octave, &cents);

  tft.fillRect(0, 90, 160, 38, ST77XX_BLACK);

  tft.setTextColor(ST77XX_WHITE);
  tft.setTextSize(2);
  tft.setCursor(10, 90);
  tft.print(noteName);
  tft.println(octave);

  // sharp/flat/in-tune indicators
  uint16_t statusColor;
  const __FlashStringHelper* statusText;
  if (abs(cents) <= inTuneCents) {
    statusColor = ST77XX_GREEN;
    statusText = F("IN TUNE");
  } else if (cents > 0) {
    statusColor = ST77XX_RED;
    statusText = F("SHARP ^");
  } else {
    statusColor = ST77XX_RED;
    statusText = F("FLAT v");
  }
  tft.setTextColor(statusColor);
  tft.setTextSize(1);
  tft.setCursor(85, 112);
  tft.println(statusText);

  tft.setTextColor(ST77XX_WHITE);
  tft.setCursor(10, 112);
  tft.print(frequency, 1);
  tft.print(F(" Hz  "));
}

void setup() {
  tft.initR(INITR_BLACKTAB);
  tft.setRotation(1);
  drawScreen();

  samplingPeriodUs = round(1000000.0 / samplingFrequency);
  actualSampleRate = 1000000.0 / samplingPeriodUs;
}

// parabolic interpolation across neighboring bins for sub-bin accuracy
double refineFrequency(int bin, float binWidth) {
  double y1 = vReal[bin - 1];
  double y2 = vReal[bin];
  double y3 = vReal[bin + 1];
  double d = (y1 - y3) / (2.0 * (y1 - 2.0 * y2 + y3));
  return (bin + d) * binWidth;
}

// signal power at one exact frequency, using the windowed samples in vImag
float powerAt(float freq) {
  float coeff = 2.0 * cos(2.0 * PI * freq / actualSampleRate);
  float s1 = 0;
  float s2 = 0;
  for (int i = 0; i < samples; i++) {
    float s = (float)vImag[i] + coeff * s1 - s2;
    s2 = s1;
    s1 = s;
  }
  return s1 * s1 + s2 * s2 - coeff * s1 * s2;
}

// fine search around a coarse FFT estimate, run ONCE per note on the stored frame
double fineRefine(double coarse) {
  // rebuild the Hamming-windowed signal from the stored samples
  for (int i = 0; i < samples; i++) {
    float w = 0.54 - 0.46 * cos(2.0 * PI * i / (samples - 1));
    vImag[i] = centered[i] * w;
  }

  // stage 1: +/- 4 Hz in 1 Hz steps
  float best = coarse;
  float bestPower = -1;
  for (int k = -4; k <= 4; k++) {
    float f = coarse + k;
    if (f < 40.0) continue;
    float p = powerAt(f);
    if (p > bestPower) {
      bestPower = p;
      best = f;
    }
  }

  // stage 2: +/- 1 Hz in 0.25 Hz steps around the stage 1 peak
  float center = best;
  bestPower = -1;
  for (int k = -4; k <= 4; k++) {
    float f = center + k * 0.25;
    float p = powerAt(f);
    if (p > bestPower) {
      bestPower = p;
      best = f;
    }
  }

  // parabolic interpolation using the neighbors of the peak
  float pm = powerAt(best - 0.25);
  float p0 = bestPower;
  float pp = powerAt(best + 0.25);
  float denom = pm - 2.0 * p0 + pp;
  if (denom < 0) {
    float d = 0.5 * (pm - pp) / denom;
    if (d > 1.0) d = 1.0;
    if (d < -1.0) d = -1.0;
    best += d * 0.25;
  }

  // if the fine search wandered far from the FFT estimate, don't trust it
  if (fabs(best - coarse) > maxRefineShift) {
    return coarse;
  }
  return best;
}

void finalizeReading() {
  // sort the readings
  for (int i = 1; i < sampleCount; i++) {
    float key = freqReadings[i];
    int j = i - 1;
    while (j >= 0 && freqReadings[j] > key) {
      freqReadings[j + 1] = freqReadings[j];
      j--;
    }
    freqReadings[j + 1] = key;
  }

  // average only the readings close to the median, ignoring octave errors
  float med = freqReadings[sampleCount / 2];
  int lo = sampleCount / 2;
  int hi = sampleCount / 2;
  while (lo > 0 && freqReadings[lo - 1] >= med * 0.95) lo--;
  while (hi < sampleCount - 1 && freqReadings[hi + 1] <= med * 1.05) hi++;
  int trim = (hi - lo + 1) / 4;
  lo += trim;
  hi -= trim;

  double sum = 0;
  for (int i = lo; i <= hi; i++) sum += freqReadings[i];
  double result = sum / (hi - lo + 1);

  // one fine analysis on the stored frame for extra accuracy
  if (haveStored) {
    double fine = fineRefine(storedPeak);
    if (storedHalved) fine /= 2.0;
    if (fabs(fine - result) <= 0.05 * result) {
      result = fine;
    }
  }

  result *= frequencyCorrection;

  updateDisplay(result);
  lastFrequency = result;
  locked = true;
  noteActive = false;
  lockTime = millis(); // start the display timer
}

void resetForNextNote() {
  noteActive = false;
  locked = false;
  sampleCount = 0;
  framesSeenThisNote = 0;
  haveStored = false;
}

void loop() {
  int maxVal = 0;
  int minVal = 1023;

  // pace sampling against micros() so the real sample rate matches samplingFrequency
  unsigned long startMicros = micros();
  for (int i = 0; i < samples; i++) {
    unsigned long targetTime = startMicros + (unsigned long)(i * samplingPeriodUs);
    while (micros() < targetTime) {}
    int sample = (analogRead(A0) + analogRead(A0)) / 2;
    vReal[i] = sample;
    vImag[i] = 0;
    if (sample > maxVal) maxVal = sample;
    if (sample < minVal) minVal = sample;
  }

  int swing = maxVal - minVal;

  // a new pluck is a loud frame that is clearly louder than the one before it
  bool newPluck = (swing >= pluckMinSwing) && (swing > prevSwing * pluckJumpRatio);
  prevSwing = swing;

  // a note is shown for at most displayHoldMs, then the screen resets
  if (locked && (millis() - lockTime >= displayHoldMs)) {
    drawScreen();
    lastFrequency = -1;
    resetForNextNote();
    waitingForRearm = true; // ignore the still-ringing string
  }

  if (swing < noiseThreshold) {
    // string may have decayed mid-accumulation, finalize with what I have
    if (noteActive && !locked && sampleCount > 0) {
      finalizeReading();
    }

    waitingForRearm = false; // the mic is quiet, ready for the next note

    silentFrameCount++;
    if (silentFrameCount >= silenceHoldFrames && lastFrequency != -1) {
      drawScreen();
      lastFrequency = -1;
      resetForNextNote();
    }
    return;
  }

  silentFrameCount = 0;

  // after a timed reset, wait for quiet or a clearly new pluck
  if (waitingForRearm) {
    if (newPluck) {
      waitingForRearm = false;
    } else {
      return;
    }
  }

  if (locked) {
    return;
  }

  // remove DC bias so it doesn't dominate the spectrum
  double total = 0;
  for (int i = 0; i < samples; i++) total += vReal[i];
  double average = total / samples;
  double maxAbs = 1;
  for (int i = 0; i < samples; i++) {
    vReal[i] -= average;
    if (fabs(vReal[i]) > maxAbs) maxAbs = fabs(vReal[i]);
  }
  // until a frame has been accepted, keep a compact copy of each frame for the analysis
  if (!haveStored) {
    double scale = 127.0 / maxAbs;
    for (int i = 0; i < samples; i++) {
      centered[i] = (int8_t)round(vReal[i] * scale);
    }
  }

  // Hamming window applied manually (same formula as the library, avoids its extra RAM use)
  for (int i = 0; i < samples; i++) {
    vReal[i] *= 0.54 - 0.46 * cos(2.0 * PI * i / (samples - 1));
  }

  FFT.compute(FFTDirection::Forward);
  FFT.complexToMagnitude();

  float binWidth = (float)samplingFrequency / samples;
  int startBin = max(1, (int)(minFreq / binWidth));
  int endBin = min((samples / 2) - 2, (int)(maxFreq / binWidth));

  int peakIndex = startBin;
  double peakVal = vReal[startBin];
  double sumVal = 0;
  int count = 0;
  for (int i = startBin; i <= endBin; i++) {
    sumVal += vReal[i];
    count++;
    if (vReal[i] > peakVal) {
      peakVal = vReal[i];
      peakIndex = i;
    }
  }
  double avgVal = sumVal / count;

  // skip this frame if the peak isn't clearly above the noise floor
  if (peakVal < avgVal * peakDominanceRatio) {
    return;
  }

  double peakFreq = refineFrequency(peakIndex, binWidth);
  double frequency = peakFreq;
  bool halved = false;

  // switch to half the frequency if the second harmonic is locked onto
  double halfFreq = frequency / 2.0;
  if (halfFreq >= minFreq) {
    int halfBin = round(halfFreq / binWidth);
    if (halfBin >= 1 && halfBin <= (samples / 2) - 2) {
      if (vReal[halfBin] > peakVal * subharmonicEnergyRatio) {
        frequency = refineFrequency(halfBin, binWidth);
        halved = true;
      }
    }
  }

  if (!noteActive) {
    noteActive = true;
    framesSeenThisNote = 0;
    sampleCount = 0;
    haveStored = false;
  }

  framesSeenThisNote++;

  if (framesSeenThisNote <= framesToSkip) {
    return;
  }

  // remember the first accepted frame for the fine analysis at the end
  if (!haveStored) {
    storedPeak = peakFreq;
    storedHalved = halved;
    haveStored = true;
  }

  freqReadings[sampleCount] = frequency;
  sampleCount++;

  if (sampleCount >= framesToAverage) {
    finalizeReading();
  }
}
